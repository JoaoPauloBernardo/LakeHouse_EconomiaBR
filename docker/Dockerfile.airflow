# Imagem do Airflow: base oficial + Java + libs do projeto + fix de TLS.
#
# POR QUE JAVA AQUI?
# Neste setup o Airflow executa os jobs PySpark direto (BashOperator ->
# python -m src...), entao ele E o driver Spark - e driver roda na JVM.
#
# TRADE-OFF (saiba defender): em producao isso e anti-padrao. O worker do
# Airflow nao deve carregar o processamento - se o job estoura RAM, derruba
# o scheduler junto. Em producao seria DatabricksSubmitRunOperator /
# KubernetesPodOperator / SparkSubmitOperator apontando pra um cluster
# EXTERNO: Airflow orquestra, nao processa.
# Localmente, rodar no worker simplifica a infra e - o ponto importante -
# NAO muda o codigo dos jobs. Migrar e trocar o operator no DAG; nada em
# src/ muda.
FROM apache/airflow:2.10.3-python3.11

# ---------------------------------------------------------------------------
# Bloco root: pacotes de sistema e certificados
# ---------------------------------------------------------------------------
USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jdk-headless ca-certificates && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# MESMO fix de TLS do Dockerfile do app - e nao e copy-paste preguicoso:
# o Airflow tambem baixa o Comex Stat (task ingest_comex), entao ele tambem
# precisa confiar na cadeia. Sem isso o cenario e o classico "funciona no
# make, falha no Airflow": SSLError "unable to get local issuer certificate"
# so na task orquestrada.
# O servidor balanca.economia.gov.br nao manda o certificado intermediario
# na negociacao; o intermediario e publico e assinado por uma CA ja
# confiavel (Sectigo) - so falta ele na cadeia.
COPY docker/certs/sectigo-public-server-auth-ov-r36.pem \
     /usr/local/share/ca-certificates/sectigo-public-server-auth-ov-r36.crt
RUN update-ca-certificates

# requests usa o bundle do certifi, nao o trust store do SO. Sem esta env,
# o update-ca-certificates acima nao teria efeito nenhum pro Python.
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# ---------------------------------------------------------------------------
# Bloco airflow: pip SEMPRE como usuario airflow
# (pip como root quebra as permissoes da imagem oficial)
# ---------------------------------------------------------------------------
USER airflow

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# PYTHONPATH aponta pra /opt/app (mesmo layout do container `app`), pra que
# `python -m src.ingestion.bcb_sgs` funcione identico nos dois lugares.
ENV PYTHONPATH=/opt/app
